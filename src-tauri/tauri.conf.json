{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Elysium",
  "version": "0.1.0",
  "identifier": "com.elysium.lan",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Elysium — Virtual LAN",
        "width": 900,
        "height": 650,
        "resizable": true,
        "center": true,
        "decorations": true,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc:; script-src 'self' 'unsafe-inline' tauri: ipc:; style-src 'self' 'unsafe-inline' tauri: ipc:; img-src 'self' data: tauri: ipc:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
